{
    "editor.rulers": [
        {
            "column": 100,
            "color": "#90ffff2c"
        },
        {
            "column": 110,
            "color": "#ffff9950"
        },
        {
            "column": 120,
            "color": "#ff9393aa"
        }
    ],
    "editor.renderWhitespace": "boundary",
    "files.eol": "\n",
    "editor.formatOnSave": true,
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true
    },
    "explorer.compactFolders": true,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "files.watcherExclude": {
        ".git/objects/**": true,
        ".git/subtree-cache/**": true,
        "*/.git/objects/**": true,
        "*/.git/subtree-cache/**": true,
    }
}
